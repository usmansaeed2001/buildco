# Normalise line endings so a Windows and a macOS contributor never produce a diff
# that claims every line of a file changed.
#
# Text files are stored LF in the repository and checked out with the platform's
# native ending. The exceptions below are files that must keep LF even on Windows,
# because something other than an editor reads them.

* text=auto

# Shell scripts and anything a Linux container executes: CRLF breaks the shebang.
*.sh            text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows-only files that genuinely want CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Source and config: normalise.
*.py            text diff=python
*.md            text
*.toml          text
*.ini           text
*.json          text
*.html          text diff=html
*.css           text
*.js            text
*.ts            text
*.tsx           text
*.sql           text

# Lockfiles are generated. Collapse them in diffs and never merge them by hand —
# regenerate instead.
uv.lock         text -diff linguist-generated
package-lock.json text -diff linguist-generated
pnpm-lock.yaml  text -diff linguist-generated

# Binary: never touch these.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.woff          binary
*.woff2         binary
