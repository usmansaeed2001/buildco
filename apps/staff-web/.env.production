# Production build config, loaded by Vite when `vite build` runs (mode=production).
#
# This file IS committed, deliberately. Vite inlines VITE_* at BUILD time, so a
# Cloud Build checkout has no other way to learn them — and without them the bundle
# ships unconfigured and redirects every user to /setup.
#
# Nothing here is secret. The Firebase web config identifies the project to Google's
# servers and is visible in any browser's network tab by design; see the comment at
# the top of src/auth/firebase.ts. Real secrets live in the backend's Secret Manager.
#
# The root .gitignore excludes `.env.*` and then re-includes this file by name.

VITE_FIREBASE_API_KEY=AIzaSyAxrv1ImjR1cg5kU9lIYyDg21QJu3_XZQc
VITE_FIREBASE_AUTH_DOMAIN=buildco-production-505918.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=buildco-production-505918
VITE_FIREBASE_STORAGE_BUCKET=buildco-production-505918.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=685076437457
VITE_FIREBASE_APP_ID=1:685076437457:web:00ce12d187ab920841a8f0

# VITE_API_BASE_URL is intentionally unset. The app calls same-origin /api/v1, which
# the Firebase Hosting rewrite forwards to Cloud Run. See docs/DEPLOYMENT.md.
