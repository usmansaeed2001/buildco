# Copy to .env for local development. Never commit a real .env.
#
# In Cloud Run these arrive as environment variables injected from Secret Manager
# (`gcloud run deploy --set-secrets`). The mapping from each variable to its secret
# name is in README.md.

# ── Core ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=local
DEBUG=true

# Canonical public origin. Approval links in reviewer emails are built from this, so
# it must be the address a reviewer can actually reach.
SITE_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Matches docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://buildco:buildco@localhost:5432/buildco

# On Cloud Run with the Cloud SQL connector, use the unix socket instead:
# DATABASE_URL=postgresql+asyncpg://buildco_app:PASSWORD@/buildco?host=/cloudsql/PROJECT:REGION:INSTANCE

DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_ECHO=false

# ── Auth ──────────────────────────────────────────────────────────────────────
# Local development without Firebase: every request runs as a synthetic owner.
# Refuses to start if ENVIRONMENT is staging or production.
AUTH_DISABLED=true
AUTH_DEV_EMAIL=dev-owner@buildco.local
AUTH_DEV_NAME=Dev Owner

# Once Firebase is provisioned, set AUTH_DISABLED=false and supply these.
# On Cloud Run, omit the credentials file and let Application Default Credentials
# resolve from the service account instead.
# FIREBASE_PROJECT_ID=buildco-prod
# FIREBASE_CREDENTIALS_FILE=./secrets/firebase-admin.json

# ── Storage ───────────────────────────────────────────────────────────────────
# Unset means attachment download URLs come back null and upload requests return 503.
# GCS_ATTACHMENTS_BUCKET=buildco-attachments
# GCS_AVATARS_BUCKET=buildco-avatars
SIGNED_URL_TTL_SECONDS=604800
SIGNED_UPLOAD_URL_TTL_SECONDS=900

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Unset means outbound email is logged and skipped, which is usually what you want
# locally — it keeps test runs from mailing real people.
# RESEND_API_KEY=re_xxxxxxxx
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# ── Slack ─────────────────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
# Unset means POST /ai/parse-estimate returns 503.
# GROQ_API_KEY=gsk_xxxxxxxx
#
# Groq retires models without keeping the old id working, and a retired id
# fails every call. Verify against https://console.groq.com/docs/models — or
# `curl -H "Authorization: Bearer $GROQ_API_KEY" \n#   https://api.groq.com/openai/v1/models` — before trusting this default.
# The model must support response_format={"type":"json_object"}.
GROQ_MODEL=openai/gpt-oss-120b

# ── Google Calendar ───────────────────────────────────────────────────────────
CALENDAR_TIMEZONE=America/Los_Angeles
